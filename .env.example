# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_PHONE=+91-00000-00000
# Number the floating WhatsApp button opens a chat with (with country code).
# Falls back to NEXT_PUBLIC_STUDIO_PHONE if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=+91-79849-25843

# ── Supabase ─────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER-ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Razorpay ─────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys (use test mode keys while developing).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard → Settings → Webhooks → the secret you set for the webhook URL
# https://yourdomain.com/api/webhooks/razorpay (subscribe to payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Resend ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be a verified sending domain/address in your Resend account.
RESEND_FROM_EMAIL="Living Yoga Studio <hello@yourdomain.com>"

# ── Cron ─────────────────────────────────────────────────────────────
# Protects /api/cron/membership-expiry from being triggered by anyone but
# your scheduler. Vercel Cron sends this automatically as a Bearer token
# once this env var is set on the project — generate any long random string.
CRON_SECRET=generate-a-long-random-string
